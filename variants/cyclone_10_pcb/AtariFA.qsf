# ---------------------------------------------------------------------------
# GENERATED FILE - do not edit.
#
# Variant : cyclone_10_pcb - AtariFA PCB v1.0 with the lisy.dev Cyclone 10 piggy back board (10CL006YE144C8G)
# Made by : scripts\gen_qsf.ps1
# Sources : scripts\common_header.tcl, device.tcl, pins.tcl,
#           scripts\files_common.tcl + files_<family>.tcl + files_<option>.tcl
#
# Change device.tcl / pins.tcl / variant.psd1 or the file lists, then rerun
# gen_qsf.ps1. Editing this file directly is lost on the next run - and Quartus
# itself writes into it when the project is open in the IDE, which is why
# check.ps1 and build.ps1 regenerate before they build.
# ---------------------------------------------------------------------------

# --- board -----------------------------------------------------------------
set_global_assignment -name TOP_LEVEL_ENTITY AtariFA
set_global_assignment -name FAMILY "Cyclone 10 LP"
set_global_assignment -name DEVICE 10CL006YE144C8G
set_global_assignment -name LAST_QUARTUS_VERSION "22.1std.2 Lite Edition"

# --- shared globals --------------------------------------------------------
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 22.1STD.2
