set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

# --- optional top level ports this board does not have ---------------------
# They stay in the port list so all variants share one top level. VIRTUAL_PIN
# keeps Quartus from placing and driving them on a real pin.
set_instance_assignment -name VIRTUAL_PIN ON -to LED_D4

