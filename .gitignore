# Quartus build artifacts. They now sit inside variants/<name>/, one set per
# variant, because that is the Quartus project directory.
db/
incremental_db/
output_files/
atom_netlists/
simulation/

# Backup files
*.bak
*.qws

# Quartus generated reports / logs
*.rpt
*.summary
*.smsg
*.pin
*.jdi
*.sld
*.done
*.qdf
*.sopcinfo

# Quartus internal
c5_pin_model_dump.txt
PLLJ_PLLSPE_INFO.txt
greybox_tmp/

# Build/verification logs
*.log

# Windows junk
Thumbs.db
desktop.ini

# Office lock/temp files (e.g. ~$AtariFA_Lamps.xlsx while open in Excel)
~$*

# Local audio sources (speech ROM is regenerated from these; see CLAUDE.md)
*.wav

# NOTE: rtl/cyclone_10/*.cmp and cpu_clock.ppf are tracked. They belong to the
#       megafunctions (the .qip lists them as MISC_FILE), so a fresh clone needs
#       them - they used to be ignored as build artefacts, which they are not.
# NOTE: rom/*.hex and rom/lisy.mif are source files, not build output.
# NOTE: the two scripts in tools/ are tracked (dis6800.py = 6800 disassembler,
#       make_speech_mif.py = speech ROM encoder). Binaries and the disassembly
#       listings they produce are not - those regenerate from the ROMs.
#       tools/listing.txt predates this rule and stays tracked.
tools/*.exe
tools/airborne_listing.txt
tools/listing_*.txt
